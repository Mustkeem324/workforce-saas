# Synkron AI — Production Environment Variables Configuration Template
# Copy this file to .env and populate with secure, high-entropy secrets

NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://app.synkron.ai

# Database Credentials
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public
REDIS_URL=redis://<REDIS_HOST>:6379

# Authentication & Encryption Secrets (Min 32 Characters)
JWT_SECRET=<YOUR_HIGH_ENTROPY_JWT_SECRET_32_CHARS_MINIMUM>
BIOMETRIC_MODEL_KEY=<YOUR_PRODUCTION_RESNET_MODEL_LICENSE_KEY>
KEK_SECRET=<YOUR_KEY_ENCRYPTION_KEY_FOR_BIOMETRIC_ENVELOPE_ENCRYPTION>
