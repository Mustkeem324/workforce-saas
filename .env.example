# Synkron AI — Production Environment Configuration

# Server Port & Execution Mode
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (MUST BE SET IN PRODUCTION)
JWT_SECRET=super-secret-production-jwt-key-change-me-in-prod-9481

# Database Configuration (SQLite WAL mode or Postgres connection URI)
DATABASE_URL=file:./server/workforce.sqlite

# Rate Limiting Parameters
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Statutory Payroll Engine Configuration (India Standard Rules)
DEFAULT_COUNTRY_CODE=IN
DEFAULT_CURRENCY=INR
STATUTORY_PF_RATE=0.12
STATUTORY_ESI_RATE=0.0075
